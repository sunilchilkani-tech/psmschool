{
  "name": "professional-school-management-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "src/index.js",
  "scripts": {
    "check": "node --check src/index.js && node --check scripts/import-legacy-export.js",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "import:legacy": "node scripts/import-legacy-export.js"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
