rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /school-assets/{schoolRef}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
